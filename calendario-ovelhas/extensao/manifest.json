{
  "manifest_version": 3,
  "name": "Lã-boratório das Ovelhas",
  "short_name": "Ovelhas",
  "description": "Calendário da Viviane e do Dov: dia de hoje, feriados brasileiros e judaicos, Shabat Shalom e atalho para o calendário compartilhado.",
  "version": "1.0.0",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lã-boratório das Ovelhas",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "Abrir o calendário das ovelhas" }
  }
}
